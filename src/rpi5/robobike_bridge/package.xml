<?xml version="1.0"?>
<package format="3">
  <name>robobike_bridge</name>
  <version>0.0.1</version>
  <description>Bridge between the ROBOBIKE HTTP API and ROS 2 (telemetry up, /cmd_vel down).</description>
  <maintainer email="maintainers@example.com">Robobike maintainers</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>robobike_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
